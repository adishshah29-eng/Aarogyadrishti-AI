# Copy to .streamlit/secrets.toml (git-ignored) to enable lab-report reading
# for everyone using this deployment. Without it, each user can paste their own
# key in the sidebar (kept for their browser session only).
# A paid-tier key is recommended: on Google's free tier, submitted content may
# be used to improve Google's products.
GEMINI_API_KEY = "your-key-here"
# GEMINI_MODEL = "gemini-2.5-flash"
